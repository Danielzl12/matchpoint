# Copia a .env (NO se sube a GitHub) o cárgalas en Vercel > Settings > Environment Variables.
# Cadena de conexión de Supabase: Project Settings > Database > Connection string > Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
# Cadena larga y aleatoria:  python -c "import secrets; print(secrets.token_hex(32))"
MATCHPOINT_SECRET=
